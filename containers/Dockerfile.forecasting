# Dockerfile for Demand Forecasting Agent
# This containerizes the forecasting agent for deployment to Amazon Bedrock AgentCore

# Use Amazon ECR Public Gallery to avoid Docker Hub rate limits
FROM public.ecr.aws/docker/library/python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY containers/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy bedrock_agentcore mock library
COPY bedrock_agentcore.py .

# Copy shared nova helper and agent code
COPY agents/nova_helper.py agents/
COPY agents/forecasting_agent_runtime.py .

# Create data directory
RUN mkdir -p /app/data

# Expose port for AgentCore Runtime
EXPOSE 8080

# Health check - verify the /ping endpoint responds
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/ping || exit 1

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8080

# Run the forecasting agent
CMD ["python", "forecasting_agent_runtime.py"]
